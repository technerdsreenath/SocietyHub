{
    "python.defaultInterpreterPath": "${workspaceFolder}/venv/Scripts/python.exe",
    "python.analysis.exclude": [
        "**/venv/**"
    ],
    "files.exclude": {
        "**/__pycache__": true,
        "**/.git": true,
        "**/venv": true
    },
    "search.exclude": {
        "**/venv": true
    },
    "files.associations": {
    "*.html": "html",
    "*.py": "python",
    "*.htm": "html"
}
}

